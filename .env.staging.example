# .env.staging.example
# Copy to .env.staging and fill in real values before deploying.
# NEVER commit .env.staging to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sahulat_staging:CHANGE_ME@localhost:5432/sahulat_staging
POSTGRES_USER=sahulat_staging
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
POSTGRES_DB=sahulat_staging

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API Server ────────────────────────────────────────────────────────────────
NODE_ENV=staging
PORT=5000
FRONTEND_URL=https://staging.sahulat.pk

# ── Seed staging database with sample data ────────────────────────────────────
# Set to "true" on first start, then "false" to avoid re-seeding
SEED_DB=true

# ── Authentication ────────────────────────────────────────────────────────────
# SECURITY: Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── 2FA / OTP ─────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_SMS_PROVIDER=easypaisa   # or jazzcash | twilio

# ── Payment Gateways ──────────────────────────────────────────────────────────
# Easypaisa sandbox
EASYPAISA_MERCHANT_ID=SANDBOX_MERCHANT_ID
EASYPAISA_MERCHANT_KEY=SANDBOX_MERCHANT_KEY
EASYPAISA_API_URL=https://easypay.easypaisa.com.pk/easypay-service/rest/v4/

# JazzCash sandbox
JAZZCASH_MERCHANT_ID=SANDBOX_MERCHANT_ID
JAZZCASH_MERCHANT_PASSWORD=SANDBOX_PASSWORD
JAZZCASH_INTEGRITY_SALT=SANDBOX_SALT
JAZZCASH_API_URL=https://sandbox.jazzcash.com.pk/ApplicationAPI/API/

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://staging-api.sahulat.pk/api

# ── AI / Translation (optional) ───────────────────────────────────────────────
AI_SERVICE_URL=
AI_SERVICE_API_KEY=
AI_TIMEOUT_MS=5000
TRANSLATION_API_URL=
TRANSLATION_API_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
